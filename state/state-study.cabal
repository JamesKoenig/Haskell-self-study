cabal-version:      3.4
name:               state-study
version:            0.0.1.0
-- synopsis:
-- description:
license:            BSD-2-Clause
license-file:       LICENSE
author:             James Koenig
maintainer:         Koenig.James@live.com
-- copyright:
category:           Data
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  State
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.17.2.0
    hs-source-dirs:   src-lib
    default-language: GHC2021

executable state-study
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.17.2.0,
        state-study

    hs-source-dirs:   src-exe
    default-language: GHC2021

test-suite state-study-test
    import:           warnings
    default-language: GHC2021
    -- other-modules:
    -- other-extensions:
    type:             exitcode-stdio-1.0
    hs-source-dirs:   src-test
    main-is:          Main.hs
    build-depends:
        base ^>=4.17.2.0
      , QuickCheck
      , state-study
